# Copy to .env (or set these in your host's dashboard). Never commit real values.

OPENAI_API_KEY=sk-...              # your OpenAI (ChatGPT) API key — you pay for all player usage
SHARED_SECRET=pon-un-secreto-largo # must match ServerConfig.SHARED_SECRET in Studio
REAL_MODEL=gpt-4o-mini            # real model behind "GPT Luna 5.6" (gpt-4o-mini = cheapest)
MODEL_ALIAS=gpt-luna-5.6
DAILY_REQUEST_CAP=3000            # hard ceiling on model calls per UTC day (0 = unlimited)
PORT=8080
